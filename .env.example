# HQD-Net Environment Configuration Template
# DO NOT COMMIT REAL SECRETS OR API KEYS TO THIS FILE OR GIT REPOSITORY.

# RAG & Evidence Layer Configuration
# Options: "heuristic" (default), "semantic", "neural", "cross_encoder", "identity"
RERANKER_MODE=heuristic

# Medical Knowledge Mode
# Options: "demo" (default), "real"
KNOWLEDGE_MODE=demo

# LLM Provider Configuration
# Options: "mock" (default), "live"
LLM_MODE=mock

# External LLM API Credentials (Required ONLY when LLM_MODE=live)
CLINICAL_LLM_API_KEY=your_api_key_here
CLINICAL_LLM_URL=https://api.openai.com/v1/chat/completions
CLINICAL_LLM_MODEL=gpt-4o-mini
